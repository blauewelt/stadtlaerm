# Gradle / Kotlin / Android build outputs (any depth, e.g. android/app/build/)
.gradle/
build/
.kotlin/
captures/
.externalNativeBuild/
.cxx/

# Machine-specific SDK path, regenerated locally
local.properties

# IDEs and OS files
.idea/
*.iml
.DS_Store

# Release signing: keystores and their passwords live outside the repository
keystore.properties
*.jks
*.keystore

# Local release artefacts. APKs are NOT ignored globally: the website ships the
# signed release as docs/download/stadtlaerm.apk. Build outputs are covered by build/.
android/dist/
*.aab

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Python bytecode (tools/)
__pycache__/
